# HANGOUT Modern Cafe Platform - Environment Variables
# Copy this file to .env and configure with your Supabase credentials

# Supabase Public API URL (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (DO NOT use service_role key here)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Cafe Instance Identifier (optional)
VITE_CAFE_NAME=HANGOUT

