# HANGOUT Modern Cafe Platform - Environment Variables Template
# Copy this file to .env.local and configure with your Supabase credentials
# NEVER commit .env.local to Git.

# Supabase Public API URL (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Publishable / client-safe key)
# DO NOT use the service_role key here — service_role must never be exposed to frontend
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-placeholder
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-placeholder

# Cafe Instance Identifier (optional)
VITE_CAFE_NAME=HANGOUT
